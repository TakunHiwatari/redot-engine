<?xml version="1.0" encoding="UTF-8" ?>
<class name="RDLogColorTheme" inherits="Resource" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../doc/class.xsd">
	<brief_description>
		Colour palette for [RDLog] output.
	</brief_description>
	<description>
		Create one of these resources, adjust its colours in the Inspector, save it as a [code].tres[/code] file and select it in [member ProjectSettings.debug/rdlog/color_theme], or assign it at runtime with [method RDLog.set_color_theme]. A new resource starts with the built-in dark colours.
		Setting a colour's alpha to [code]0[/code] leaves that kind of output uncoloured.
		[b]Converting a log.gd theme:[/b] the colour property names match log.gd's [code]LogColorTheme[/code]. In the [code].tres[/code] file, replace the header's [code]type="Resource" script_class="LogColorTheme"[/code] with [code]type="RDLogColorTheme"[/code], delete the [code]ext_resource[/code] line pointing at [code]log_color_theme.gd[/code] and the [code]script = ...[/code] line, and change [code]Array[Color]([...])[/code] values to [code]PackedColorArray(...)[/code].
	</description>
	<tutorials>
	</tutorials>
	<methods>
		<method name="create_dark" qualifiers="static">
			<return type="RDLogColorTheme" />
			<description>
				Returns a new theme with the built-in dark colours, for terminals and editors with a dark background.
			</description>
		</method>
		<method name="create_light" qualifiers="static">
			<return type="RDLogColorTheme" />
			<description>
				Returns a new theme with the built-in light colours, for light backgrounds.
			</description>
		</method>
		<method name="get_theme_color" qualifiers="const">
			<return type="Color" />
			<param index="0" name="index" type="int" enum="RDLogColorTheme.ThemeColor" />
			<description>
				Returns the colour at [param index]. Each index also has a property, such as [member color_int].
			</description>
		</method>
		<method name="set_theme_color">
			<return type="void" />
			<param index="0" name="index" type="int" enum="RDLogColorTheme.ThemeColor" />
			<param index="1" name="color" type="Color" />
			<description>
				Sets the colour at [param index]. Each index also has a property, such as [member color_int].
			</description>
		</method>
	</methods>
